# Copy this file to .env (or paste the keys in Settings → Your API keys).

# Needed: a free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: natural voices from https://elevenlabs.io (otherwise a free voice runs on your computer)
ELEVENLABS_API_KEY=

# Optional: any OpenAI-compatible API instead of Groq
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
