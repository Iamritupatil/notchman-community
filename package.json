{
  "name": "notchman-community",
  "productName": "Notchman Community",
  "version": "1.0.0",
  "description": "Copy anything, hear the TL;DR. Notchman for Windows and Mac with your own API keys. Free for personal, non-commercial use.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Ritu Patil",
  "homepage": "https://notchman.app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/community.test.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.notchman.community",
    "productName": "Notchman Community",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.{md,map,ts}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Notchman-Community-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Notchman Community"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Notchman-Community-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Notchman",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
